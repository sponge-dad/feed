# =====================================================================
# FeedMind Agent 环境变量示例
#
# 复制为 .env 并按需填写：cp .env.example .env
#
# ⚠️ 红线（宪法 III.3）：本文件只声明变量名与用途，禁止提交任何真实值。
#    Secrets 一律通过环境变量注入，不落代码、不进 git。
# =====================================================================

# ---------------------------------------------------------------------
# 内容分析（Content Worker / Content RPC）
# ---------------------------------------------------------------------

# FFmpeg / ffprobe 绝对路径。
# 本机已安装 johnvansickle 静态编译版 7.0.2（/usr/local/bin），
# 若部署到其他机器，执行 `which ffmpeg ffprobe` 确认路径。
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe

# 多模态 LLM（内容标签生成 + Agent 意图识别/语言组织），火山方舟 ARK
ARK_API_KEY=
ARK_MODEL=

# 外部语音识别（ASR）服务凭证
ASR_API_KEY=

# 外部文字识别（OCR）服务凭证
OCR_API_KEY=

# Elasticsearch 地址（feed_content_v1 检索索引）
ES_ADDR=http://127.0.0.1:9200

# Content 服务 MySQL DSN（feed_content 库）
# 格式: root:password@tcp(127.0.0.1:3306)/feed_content?charset=utf8mb4&parseTime=True&loc=Local
CONTENT_MYSQL_DSN=

# Agent 服务 MySQL DSN（feed_agent 库）
# 格式: root:password@tcp(127.0.0.1:3306)/feed_agent?charset=utf8mb4&parseTime=True&loc=Local
AGENT_MYSQL_DSN=
