# 编译产物
/bin/
*.exe
*.out

# Go
vendor/
*.test
*.prof

# IDE
.idea/
.vscode/
*.swp

# 日志与临时文件
# logs/ 为统一日志根目录（见 Makefile /各服务 etc/*.yaml 的 Log 配置），整体忽略，
# 同时兼容 logx 按天滚动产生的带日期后缀文件（如 access.log-2026-08-05）及压缩产物。
logs/
*.log

# goctl 生成骨架临时目录（生成 pb 时使用，勿提交）
.interaction_gen_tmp/
*.log-*
*.log.gz
tmp/
.DS_Store

# 本地配置（含密钥，不入库）
*.local.yaml
scripts/cos-env.sh
deploy/config/*.prod.yaml
.xac/
# proto 生成的 pb 代码（由 goctl 在 CVM 本地生成，不入库）
# 如需入库可注释掉下面两行
#app/*/rpc/*/*.pb.go
#app/*/rpc/*/*_grpc.pb.go

uptest
uptest
